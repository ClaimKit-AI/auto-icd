{
  "name": "icd-api",
  "version": "1.0.0",
  "description": "ICD Suggest & Specifier Tray - Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "echo \"Tests coming soon\" && exit 0",
    "embeddings:all": "node generate_all_embeddings.js",
    "embeddings:resume": "node generate_all_embeddings.js --resume",
    "embeddings:5k": "node generate_all_embeddings.js --limit=5000 --batch=5",
    "embeddings:window": "node generate_all_embeddings.js --limit=%LIMIT% --offset=%OFFSET% --batch=%BATCH%",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:start:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:stop": "pm2 stop icd-api",
    "pm2:restart": "pm2 restart icd-api",
    "pm2:delete": "pm2 delete icd-api",
    "pm2:logs": "pm2 logs icd-api --lines 50",
    "pm2:status": "pm2 list",
    "deploy:prod": "pm2 stop icd-api || true && pm2 delete icd-api || true && pm2 start ecosystem.config.cjs --env production && pm2 save",
    "deploy:dev": "pm2 stop icd-api || true && pm2 delete icd-api || true && pm2 start ecosystem.config.cjs --env development && pm2 save"
  },
  "keywords": [
    "icd",
    "medical",
    "diagnosis",
    "api"
  ],
  "author": "ICD Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/websocket": "^8.3.1",
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "lru-cache": "^10.0.1",
    "openai": "^4.104.0",
    "pg": "^8.11.3",
    "ws": "^8.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
