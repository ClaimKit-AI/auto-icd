# ICD-10-CM Diagnosis Assistant - API Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supabase PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Get this from: Supabase Dashboard > Project Settings > Database > Connection String
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# OpenAI API key for generating embeddings
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# DEEPGRAM CONFIGURATION
# =============================================================================
# Deepgram API key for TRUE real-time medical transcription
# Get FREE key (45,000 min/month) at: https://console.deepgram.com/signup
# Nova-2-Medical model: Best for medical vocabulary
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port the API server will listen on
PORT=3000

# Environment: development, staging, or production
NODE_ENV=production

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Maximum number of search suggestions to return
MAX_SUGGESTIONS=8

# =============================================================================
# CORS CONFIGURATION (Optional)
# =============================================================================
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://aicd.claimkit.ai,https://www.aicd.claimkit.ai

